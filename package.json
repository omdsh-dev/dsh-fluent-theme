{
  "name": "@shellraining/dsh-fluent-theme",
  "version": "0.1.10",
  "type": "module",
  "description": "Windows 10-inspired acrylic backgrounds, Reveal lighting, and interaction animations for DSH.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "host-tokens": "node scripts/host-tokens.mjs",
    "typecheck": "tsc -p tools/tsconfig.json && tsc -p tsconfig.json",
    "dev": "node --watch-path=src --watch-preserve-output build.ts",
    "build": "pnpm run typecheck && node build.ts",
    "check": "pnpm typecheck && pnpm build"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.3",
    "@types/react": "18.3.31",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-fluent-theme.git"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-fluent-theme#readme",
  "bugs": "https://github.com/omdsh-dev/dsh-fluent-theme/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.png",
  "packageManager": "pnpm@12.6.0"
}
